---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Byline from "../../components/Byline.astro";
import JsonLd from "../../components/JsonLd.astro";
import { canonical } from "../../lib/site";

const title = "URL Slug Guides & Architecture Reference";
const description =
  "Five references on what a URL slug is, how to make one, hyphens, non-English characters, and generating slugs from a list or file.";
const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: canonical("/") },
    { "@type": "ListItem", position: 2, name: "Guides", item: canonical("/guides") },
  ],
};
---

<BaseLayout title={title} description={description} path="/guides" kind="document">
  <article class="prose" data-countable>
    <p class="crumbs"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>Guides</span></p>
    <h1>URL Slug Reference Guides</h1>
    <Byline />
    <p>
      These technical guides clarify the mechanics, SEO impact, and internationalization standards behind URL slug creation. They are delivered as semantic HTML and remain completely accessible without JavaScript. The interactive generator tools are available on the <a href="/">Single Slug Tool</a> and the <a href="/bulk-slug-generator">Bulk Slug Generator</a>.
    </p>
    <h2>The five core references</h2>
    <ul class="guide-cards">
      <li class="guide-card-item">
        <a class="guide-card" href="/guides/what-is-a-url-slug">
          <span class="guide-card-title">What is a URL slug? <span class="guide-card-arrow" aria-hidden="true">&rarr;</span></span>
          <span class="guide-card-desc">Defines the slug within the anatomy of a complete web address, contrasting slugs against query strings and fragments.</span>
        </a>
      </li>
      <li class="guide-card-item">
        <a class="guide-card" href="/guides/how-to-create-url-slugs">
          <span class="guide-card-title">How to create a URL slug <span class="guide-card-arrow" aria-hidden="true">&rarr;</span></span>
          <span class="guide-card-desc">Detailed walkthrough of the sanitization pipeline: lowercase conversion, word boundaries, stop words, and length capping.</span>
        </a>
      </li>
      <li class="guide-card-item">
        <a class="guide-card" href="/guides/hyphens-vs-underscores-in-urls">
          <span class="guide-card-title">Hyphens and underscores in URLs <span class="guide-card-arrow" aria-hidden="true">&rarr;</span></span>
          <span class="guide-card-desc">Google's search indexing recommendations, crawler word delimitation, and why live URLs should rarely be renamed.</span>
        </a>
      </li>
      <li class="guide-card-item">
        <a class="guide-card" href="/guides/unicode-and-international-urls">
          <span class="guide-card-title">International characters &amp; UTF-8 <span class="guide-card-arrow" aria-hidden="true">&rarr;</span></span>
          <span class="guide-card-desc">Covers ASCII folding for Latin diacritics versus native character preservation for non-Latin writing systems.</span>
        </a>
      </li>
      <li class="guide-card-item">
        <a class="guide-card" href="/guides/bulk-url-slug-generation">
          <span class="guide-card-title">How to generate slugs in bulk <span class="guide-card-arrow" aria-hidden="true">&rarr;</span></span>
          <span class="guide-card-desc">Best practices for spreadsheets and CSV exports, column mapping, 10,000-row batch limits, and duplicate disambiguation.</span>
        </a>
      </li>
    </ul>
    <h2>Content philosophy and scope</h2>
    <p>
      We purposefully avoid fragmented micro-articles for isolated stop words or artificial keyword optimization tricks. Practical considerations are integrated directly into the relevant functional guides so technical documentation remains authoritative and concise.
    </p>
    <p>
      For privacy principles, visit our <a href="/privacy">Privacy Policy</a>. For bugs or feature feedback, visit our <a href="/contact">GitHub Issues tracker</a>.
    </p>
  </article>
  <JsonLd data={schema} />
</BaseLayout>

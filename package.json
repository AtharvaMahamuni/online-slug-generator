    "@fontsource/jetbrains-mono": "5.2.8",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.11.2",
    "@playwright/test": "1.58.2",
    "happy-dom": "20.8.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
